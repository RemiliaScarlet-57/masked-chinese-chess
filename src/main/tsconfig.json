{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["ES2020"],
    "skipLibCheck": true,
    "outDir": "../../dist/main",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["**/*.ts"]
}
